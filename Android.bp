package {
    default_applicable_licenses: ["external_conscrypt_license"],
}

license {
    name: "external_conscrypt_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

prebuilt_apex {
    name: "com.android.conscrypt",
    apex_name: "com.android.conscrypt",
    source_apex_name: "com.android.conscrypt",
    arch: {
        x86_64: {
            src: "org.blisslabs.ag.ext.conscrypt.apex",
        },
    },
    filename: "com.android.conscrypt.apex",
    exported_bootclasspath_fragments: ["com.android.conscrypt-bootclasspath-fragment"],
    exported_java_libs: ["conscrypt"],
    prefer: true,
    installable: true,
}

prebuilt_apex {
    name: "org.blisslabs.ag.ext.conscrypt",
    apex_name: "org.blisslabs.ag.ext.conscrypt",
    source_apex_name: "org.blisslabs.ag.ext.conscrypt",
    arch: {
        x86_64: {
            src: "org.blisslabs.ag.ext.conscrypt.apex",
        },
    },
    filename: "org.blisslabs.ag.ext.conscrypt.apex",
}

cc_prebuilt_library_shared {
    name: "libconscrypt_openjdk_jni",
    host_supported: true,
    check_elf_files: false,
    prefer: true,
    arch: {
        x86_64: {
            srcs: ["lib64/libconscrypt_openjdk_jni.so"],
        },
        x86: {
            srcs: ["lib/libconscrypt_openjdk_jni.so"],
        },
    },
    apex_available: [
        "com.android.conscrypt",
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    visibility: ["//visibility:public"],
}

java_import {
    name: "conscrypt-unbundled",
    jars: ["share/conscrypt/conscrypt-unbundled.jar"],
    host_supported: true,
    prefer: true,
    sdk_version: "core_current",
    min_sdk_version: "29",
    apex_available: [
        "com.android.conscrypt",
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

java_import {
    name: "conscrypt-lite",
    jars: ["share/conscrypt/conscrypt-lite.jar"],
    host_supported: true,
    prefer: true,
    sdk_version: "core_current",
    min_sdk_version: "29",
    apex_available: [
        "com.android.conscrypt",
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

java_import {
    name: "conscrypt",
    jars: ["share/conscrypt/conscrypt-unbundled.jar"],
    host_supported: true,
    sdk_version: "none",
    min_sdk_version: "29",
    prefer: true,
    apex_available: [
        "com.android.conscrypt",
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    visibility: ["//visibility:public"],
}

filegroup {
    name: "conscrypt_java_files",
    visibility: ["//visibility:public"],
    srcs: ["Empty.java"],
}

filegroup {
    name: "conscrypt_public_api_files",
    visibility: ["//visibility:public"],
    srcs: ["Empty.java"],
}

java_library {
    name: "conscrypt-for-host",
    visibility: ["//visibility:public"],
    static_libs: ["conscrypt"],
    sdk_version: "none",
    system_modules: "none",
}

// -----------------------------------------------------------------------------
// Core Crypto Java API Libraries
// -----------------------------------------------------------------------------

java_sdk_library_import {
    name: "conscrypt.module.public.api",
    prefer: true,
    shared_library: false,
    public: {
        jars: ["share/conscrypt/conscrypt-public.jar"],
        sdk_version: "none",
    },
    system: {
        jars: ["share/conscrypt/conscrypt-system.jar"],
        sdk_version: "none",
    },
    module_lib: {
        jars: ["share/conscrypt/conscrypt-module-lib.jar"],
        sdk_version: "none",
    },
    visibility: ["//visibility:public"],
}

java_import {
    name: "conscrypt.module.platform.api.stubs",
    jars: ["share/conscrypt/conscrypt-coreplatform.jar"],
    sdk_version: "none",
    visibility: ["//visibility:public"],
}

java_import {
    name: "conscrypt.module.platform.api.stubs.exportable",
    jars: ["share/conscrypt/conscrypt-coreplatform.jar"],
    sdk_version: "none",
    visibility: ["//visibility:public"],
}

